# IA usada pelo assessor: gemini ou claude. Preencha so a chave do escolhido.
AI_PROVIDER=gemini

# Gemini (https://aistudio.google.com/apikey). No Gemini o audio vai direto para o modelo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Usado se o principal estiver sobrecarregado ou sem resposta. Deixe vazio para desligar.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Claude (https://console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
# Modelo padrao; troque por claude-sonnet-5-5 ou claude-haiku-5-5 para reduzir custo
CLAUDE_MODEL=claude-opus-5-5

# WhatsApp Cloud API (developers.facebook.com > seu app > WhatsApp > Configuracao da API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto qualquer, igual ao informado no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=troque-por-um-texto-secreto
# Configuracoes do app > Basico > Chave secreta do app (valida a assinatura do webhook)
WHATSAPP_APP_SECRET=

# Modelo aprovado para lembretes e resumo (opcional, veja o README). Sem ele, os avisos
# so chegam se voce falou com o assessor nas ultimas 24 horas.
WHATSAPP_NOTICE_TEMPLATE=
WHATSAPP_NOTICE_TEMPLATE_LANG=pt_BR

# Numero do WhatsApp do assessor (o numero de teste da Meta), para o botao "Conversar no WhatsApp"
# do painel. Opcional: com WHATSAPP_TOKEN e WHATSAPP_PHONE_NUMBER_ID preenchidos, ele e descoberto sozinho.
WHATSAPP_NUMERO=

# Seu numero com DDI e DDD, so digitos. Varios separados por virgula.
ALLOWED_NUMBERS=5511999999999

# Transcricao de audio (opcional; com Gemini nao precisa). Qualquer API compativel com /audio/transcriptions.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1

# Painel web (npm run painel). Cada pessoa entra com a propria conta (e-mail e senha).
# Opcional: chave de servico no cabecalho x-painel-token, que ve os dados de PAINEL_TELEFONE.
PAINEL_TOKEN=
# Padrao e o telefone do chat do terminal (5500000000000)
PAINEL_TELEFONE=
PAINEL_PORT=3001

PORT=3000
TIMEZONE=America/Sao_Paulo
DAILY_SUMMARY_HOUR=7
